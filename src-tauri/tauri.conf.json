{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewAPI监控",
  "version": "1.0.3",
  "identifier": "com.ybondcoder.newapi-tray-monitor.tauri",
  "build": {
    "beforeDevCommand": "npm run build:tauri:dev",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NewAPI监控",
        "width": 240,
        "height": 112,
        "minWidth": 240,
        "minHeight": 112,
        "maxWidth": 240,
        "maxHeight": 112,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ybd0612/newapi-tray-monitor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2NTAyM0I4QkUxMzc4RDUKUldUVmVCTyt1Q05RcGtlaFFrK0lqRTRRWkh2ZGVha0w5UjNrVkdoMm5zbWo4SmVlL3lHZ3ZxQ00K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
